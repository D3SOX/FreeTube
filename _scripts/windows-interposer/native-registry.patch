diff --git a/LANCommander.Interposer/dll/src/dllmain.cpp b/LANCommander.Interposer/dll/src/dllmain.cpp
index 7989945..9f33edb 100644
--- a/LANCommander.Interposer/dll/src/dllmain.cpp
+++ b/LANCommander.Interposer/dll/src/dllmain.cpp
@@ -1,55 +1,32 @@
-#define WIN32_LEAN_AND_MEAN
-#define NOMINMAX
 #include <windows.h>
 #include "hooks.h"
+#include <exception>
+#include <cstring>
 
-static void WriteLog(const wchar_t* message)
+BOOL APIENTRY DllMain(HMODULE instance, DWORD reason, LPVOID reserved)
 {
-    wchar_t temporaryPath[MAX_PATH];
-    
-    GetTempPathW(MAX_PATH, temporaryPath);
-    
-    wcscat_s(temporaryPath, L"Interposer.log");
-    
-    HANDLE fileHandle = CreateFileW(temporaryPath, FILE_APPEND_DATA, FILE_SHARE_READ,
-        nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
-    
-    if (fileHandle == INVALID_HANDLE_VALUE) 
-        return;
-    
-    DWORD written;
-    
-    WriteFile(fileHandle, message, static_cast<DWORD>(wcslen(message) * sizeof(wchar_t)), &written, nullptr);
-    WriteFile(fileHandle, L"\r\n", 4, &written, nullptr);
-    CloseHandle(fileHandle);
-}
-
-BOOL APIENTRY DllMain(HMODULE hInstance, DWORD fdwReason, LPVOID /*lpvReserved*/)
-{
-    switch (fdwReason)
-    {
-    case DLL_PROCESS_ATTACH:
-        DisableThreadLibraryCalls(hInstance);
-        WriteLog(L"DLL_PROCESS_ATTACH: calling InstallHooks");
-        __try
-        {
-            InstallHooks();
-            WriteLog(L"InstallHooks returned OK");
+    if (reason == DLL_PROCESS_ATTACH) {
+        DisableThreadLibraryCalls(instance);
+        try { InstallHooks(); }
+        catch (const std::exception& error) {
+            DWORD written;
+            const char* message = error.what();
+            WriteFile(GetStdHandle(STD_ERROR_HANDLE), message, static_cast<DWORD>(std::strlen(message)), &written, nullptr);
+            WriteFile(GetStdHandle(STD_ERROR_HANDLE), "\n", 1, &written, nullptr);
+            // [DEBUG-1163] Child stderr may be closed by the sandbox. Encode the
+            // failing stage in its process exit code for the diagnostic run.
+            UINT diagnostic = 0x11630009;
+            if (std::strstr(message, "Cannot resolve current user")) diagnostic = 0x11630001;
+            if (std::strstr(message, "Cannot load portable registry hive")) diagnostic = 0x11630002;
+            if (std::strstr(message, "Registry hook installation")) diagnostic = 0x11630003;
+            if (std::strstr(message, "Cannot enable portable hooks")) diagnostic = 0x11630004;
+            if (std::strstr(message, "Cannot create portable registry directory")) diagnostic = 0x11630005;
+            TerminateProcess(GetCurrentProcess(), diagnostic);
+            return FALSE;
         }
-        __except (EXCEPTION_EXECUTE_HANDLER)
-        {
-            wchar_t buf[64];
-            wsprintfW(buf, L"InstallHooks EXCEPTION code=0x%08X", GetExceptionCode());
-            WriteLog(buf);
-        }
-        break;
-
-    case DLL_PROCESS_DETACH:
+        catch (...) { TerminateProcess(GetCurrentProcess(), 0x1163000A); return FALSE; }
+    } else if (reason == DLL_PROCESS_DETACH && !reserved) {
         RemoveHooks();
-        break;
-
-    default:
-        break;
     }
     return TRUE;
 }
